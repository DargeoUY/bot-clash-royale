{
  "name": "bot-clash-royale",
  "version": "0.2.0",
  "description": "Bot de Discord para administración de Clash Royale — tracking de guerras, puntos, inactividad y más",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy:commands": "tsx src/discord/deploy-commands.ts",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "db:deploy": "prisma migrate deploy",
    "backup": "node -e \"require('./dist/tasks/backup-database').backupDatabase().catch(()=>process.exit(1))\"",
    "test:integration": "INTEGRATION_TESTS=1 vitest run tests/integration.test.ts"
  },
  "keywords": [
    "discord",
    "clash-royale",
    "bot",
    "clan-management"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.15.0",
    "@whiskeysockets/baileys": "^6.7.23",
    "axios": "^1.7.2",
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "grammy": "^1.20.0",
    "node-cron": "^3.0.3",
    "qrcode": "^1.5.4",
    "winston": "^3.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^7.12.0",
    "@typescript-eslint/parser": "^7.12.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.1",
    "prisma": "^5.15.0",
    "supertest": "^7.3.2",
    "tsx": "^4.15.1",
    "typescript": "^5.4.5",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
